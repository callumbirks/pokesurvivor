{
  "name": "@pokesurvivor/sim",
  "version": "0.0.0",
  "private": true,
  "description": "Headless simulation. No DOM, Canvas or Audio: runs in Node and in a Web Worker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc && tsc -p test",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "bench": "tsx test/bench.ts",
    "shields": "tsx test/measure-shields.ts",
    "heals": "tsx test/measure-heals.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "rifts": "tsx test/measure-rifts.ts",
    "rifts:summary": "tsx test/summarize-rifts.ts",
    "rifts:fit": "tsx test/fit-rift-curve.ts",
    "wilds": "tsx test/measure-wilds.ts"
  },
  "dependencies": {
    "@pokesurvivor/data": "workspace:*",
    "@pokesurvivor/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  }
}
