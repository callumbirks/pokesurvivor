# Copy to .env at the repo root to override the dev defaults (pnpm dev and pnpm db:migrate load it).
# Default: the docker-compose Postgres. Required when NODE_ENV=production.
DATABASE_URL=postgres://pokesurvivor:pokesurvivor@localhost:5432/pokesurvivor
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to false to skip running migrations on server start.
MIGRATE_ON_START=true
# Override where the server finds the built client and the sprites.
# CLIENT_DIR=apps/client/dist
# ASSETS_DIR=assets
# Session cookie Secure flag; defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Daily/weekly leaderboards reset at midnight in this time zone.
LEADERBOARD_TIME_ZONE=Europe/Madrid
# Requests per minute per IP: login and register (each), and starting runs / friend requests.
AUTH_RATE_LIMIT_MAX=10
ACTION_RATE_LIMIT_MAX=60
# Solo runs: a run whose last checkpoint is this old (and that was never reported) is credited
# from that checkpoint; the server checks every RUN_SWEEP_INTERVAL_S.
RUN_CHECKPOINT_TIMEOUT_S=3600
RUN_SWEEP_INTERVAL_S=60
# Game server: snapshots per second, coop choice timeout, reconnect grace and loading timeout.
SNAPSHOT_HZ=20
CHOICE_TIMEOUT_S=30
RECONNECT_GRACE_S=60
LOADING_TIMEOUT_S=15
# On SIGTERM (deploys), running games may finish for up to this long. Set the container's stop
# grace period a little higher (docs/deploy.md).
DRAIN_TIMEOUT_S=900
